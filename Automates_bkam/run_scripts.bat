@echo off
echo Activation de l'environnement virtuel...
call ..\.venv\Scripts\activate

echo Installation des dependances depuis requirements_bkam.txt...
pip install -r requirements_bkam.txt

echo Execution des scripts BKAM...

echo 1. Telechargement des taux de change de la veille...
python bkam_cours_autonome.py

echo 2. Concatenation des taux de change...
python concat_bkam.py

echo 3. Telechargement des taux de reference des bons du Tresor de la veille...
python download_bkam_taux_csvs.py

echo 4. Concatenation des taux de reference des bons du Tresor...
python concatenate_bkam_taux_csvs.py

echo Desactivation de l'environnement virtuel...
deactivate

echo Fin de l'execution. Appuyez sur une touche pour quitter...
pause